# Supabase – aus dem Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic – aus https://console.anthropic.com (für KI-Hebammen-Chat)
# Wenn leer gelassen, läuft der Chat im Demo-Modus mit Mock-Antworten.
ANTHROPIC_API_KEY=

# ---- OPTIONAL: Weekly-Summary Cron (Feature 81) ----
# Server-role key (SERVER ONLY!) – wird vom /api/cron/weekly-summary gebraucht,
# um über ALLE User zu iterieren. NICHT im Client verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# Resend Transactional-Mail-Provider — https://resend.com/api-keys (3000 Mails/Monat frei).
# Wenn gesetzt: /api/cron/weekly-summary schickt echte E-Mails.
# Wenn leer: Endpoint läuft im No-Op-Modus und loggt nur "would send to X".
RESEND_API_KEY=

# Optional: Schutz gegen ungewollte Cron-Aufrufe von außen.
# Vercel schickt den Vercel-Cron-Header automatisch — dieser Secret ist nur nötig
# wenn du den Endpoint auch manuell mit `Authorization: Bearer …` schützen willst.
CRON_SECRET=

# ---- PROJ-10: Web Push Notifications ----
# VAPID Keys — einmalig generieren mit:
#   node -e "const wp=require('web-push');const v=wp.generateVAPIDKeys();console.log(v);"
# Public Key wird im Client benoetigt (NEXT_PUBLIC_-Praefix, safe to expose).
# Private Key ausschliesslich Server-seitig, niemals im Client oder in Logs.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: oder https:// — laut RFC 8292 fuer Push-Provider-Kontakt.
VAPID_SUBJECT=mailto:hallo@mamamap.app
